{
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "__ADB_HOME__/.claude/scripts/precommit-gate.sh",
          "timeout": 240,
          "statusMessage": "ai-dev-baseline: quality gates"
        },
        {
          "type": "command",
          "command": "__ADB_HOME__/.claude/scripts/implement-issue-gate.sh",
          "timeout": 30,
          "statusMessage": "ai-dev-baseline: implement-issue completion gate"
        },
        {
          "type": "command",
          "command": "__ADB_HOME__/.claude/scripts/state-claim-gate.sh",
          "timeout": 20,
          "statusMessage": "ai-dev-baseline: state-claim gate"
        }
      ]
    }
  ],
  "SessionStart": [
    {
      "matcher": "startup",
      "hooks": [
        {
          "type": "command",
          "command": "__ADB_HOME__/.claude/scripts/session-currency.sh",
          "timeout": 60,
          "statusMessage": "ai-dev-baseline: install currency"
        }
      ]
    }
  ]
}
