#!/usr/bin/env bash
# ai-dev-baseline — keep the INSTALLED baseline current.
#
# The baseline installs by symlinking a stable clone (e.g. ~/Code/ai-dev-baseline)
# into ~/.<agent>. Keeping that clone current used to be a remembered ritual:
# `git pull` + maybe re-run `install.sh` if a PR moved an installed path. This
# command replaces that ritual with one idempotent entrypoint.
#
# Usage:
#   baseline update            # fast-forward the install-source clone + self-heal links
#   baseline update --check    # report currency only; make NO changes (for a hook)
#   baseline skill-compose …   # compose a project's partial skill overrides (issue #22;
#                              #   run 'baseline skill-compose -h' for its own usage)
#   baseline repo …            # hand PR merges to GitHub: 'checks' / 'status' / 'apply' to set
#                              #   required status checks then allow_auto_merge; 'automerge-ok',
#                              #   the guard /implement-issue asks before it arms auto-merge;
#                              #   'required-drift', the CI lint that catches a newly added job
#                              #   staying non-required; 'reconcile', the opt-in repair for what
#                              #   that lint only reports; and 'merge-flag' (issues #87, #122,
#                              #   #333; 'baseline repo -h' for more)
#   baseline release …         # the optional release-goal convention in this repo: 'init' /
#                              #   'status' to stand it up, 'roll' to roll the milestone after a
#                              #   release is cut (issues #27/#74; 'baseline release -h' for more)
#   baseline pinned …          # the RELEASE-PINNED per-project install (#285): 'install' /
#                              #   'status' / 'upgrade --to X.Y.Z' / 'uninstall'. It operates on
#                              #   the PROJECT you are standing in, never on the install-source
#                              #   clone ('baseline pinned -h' for more)
#   baseline adopt status      # the ADOPTION COMPLETION CONTRACT (#81): is this project actually
#                              #   ready to run the loop? Every rung fail-closed — a fact that
#                              #   could not be established is never a pass. Re-runnable any time;
#                              #   exits 0 green / 10 red / 11 indeterminate
#   baseline -h | --help
#
# `update` never touches unsafe state: it fast-forwards ONLY when the install-source
# clone is clean, on its default branch, free of an in-progress git operation, and merely
# behind origin. A dirty / in-progress / detached / non-default / ahead / diverged clone is
# surfaced and left untouched — currency is a convenience, never a cause of lost work. Those
# unsafe states are classified from LOCAL state BEFORE any fetch, so a run that is going to
# refuse costs no network round trip and writes no remote-tracking refs. After a fast-forward it re-runs the
# idempotent installer ONLY when an installed path actually moved (a symlink stopped
# resolving), preserving the exact agent set + hook preference already installed. It first
# PRUNES orphaned links a rename/removal left behind (ownership-scoped — only a dangling
# symlink pointing into the clone), then LOUDLY verifies every canonical manifest link resolves.
#
# The two-clone dev split: this command operates on the clone the global install
# points INTO (the "install-source"). Run from any other clone it refuses, so a dev
# clone is never mistaken for the install source. The dev clone is kept current by
# `/implement-issue`'s preflight auto-sync (issue #17) instead.
#
# `--check` exit codes (the stable machine contract the Claude SessionStart currency hook
# consumes, issue #36): 0 = current · 10 = behind (update available) · 20 = needs attention
# (dirty|in-progress|ahead|diverged|detached|not-default) · 30 = error (fetch failed | no
# origin/<default> | not a repo). It prints one status word to stdout and changes nothing in
# the working tree; it fetches (writing remote-tracking refs) only when local state is
# otherwise safe, since the refusing states are decided without the network.
#
# `update` additionally exits 5 when another `baseline update` already holds the per-clone
# lock. Concurrent updates are ordinary now that a SessionStart hook can start several at
# once, so the second one steps aside instead of racing the first through pull + install.
# It exits 6 on a SUCCESSFUL same-HEAD repair — the clone was already current but an installed
# link was broken and has been restored. Distinct from 0 ("nothing to do") because the installed
# surface changed while HEAD did not, which a caller watching HEAD alone cannot see.

set -uo pipefail

# Resolve our own location through symlinks (this script may be reached via a PATH
# symlink) — then find the repo root above bin/. A relative symlink target is resolved
# against the LINK's own directory (not the caller's CWD), so a relative PATH symlink
# (stow/brew style) doesn't yield an empty REPO. Paths stay logical to match how
# install.sh records its symlink targets; the wrong-clone guard below uses `-ef`
# (same-inode) so a symlinked path spelling never causes a false mismatch.
_adb_boot_src="${BASH_SOURCE[0]}"
# ADB-SYMWALK-BEGIN (#343) — BYTE-IDENTICAL IN bin/baseline AND bin/agent-init; pinned by
# scripts/check-bootstrap.sh. A relative symlink target resolves against the LINK's own directory,
# not the caller's cwd. `readlink -n` is what makes the walk lossless — plain `readlink` appends a
# newline on GNU but NOT when the target already ends in one on BSD, so the two are indistinguishable
# there and no sentinel can recover the difference; `-n` emits the target raw on both.
while [ -L "$_adb_boot_src" ]; do
  _adb_boot_link="$(readlink -n -- "$_adb_boot_src" && printf 'X')"; _adb_boot_link="${_adb_boot_link%X}"
  case "$_adb_boot_link" in
    /*) _adb_boot_src="$_adb_boot_link" ;;
    *)  _adb_boot_dir="${_adb_boot_src%/*}"
        if [ "$_adb_boot_dir" = "$_adb_boot_src" ]; then _adb_boot_dir="."; elif [ -z "$_adb_boot_dir" ]; then _adb_boot_dir="/"; fi
        _adb_boot_src="$_adb_boot_dir/$_adb_boot_link" ;;
  esac
done
# ADB-SYMWALK-END
_adb_boot_rel=".."
# ADB-BOOTSTRAP-BEGIN (#343) — BYTE-IDENTICAL IN EVERY ENTRY POINT; pinned by scripts/check-bootstrap.sh,
# which carries why each line is shaped this way. Lossless because `$(…)` strips every trailing newline:
# `${src%/*}` cannot strip, and the `X` sentinel bounds what the `pwd` capture can. Logical `pwd` (not
# `-P`) preserves how install.sh records its symlink targets. bash 3.2-safe: this runs before the gate.
_adb_boot_dir="${_adb_boot_src%/*}"
if [ "$_adb_boot_dir" = "$_adb_boot_src" ]; then _adb_boot_dir="."; elif [ -z "$_adb_boot_dir" ]; then _adb_boot_dir="/"; fi
_adb_boot_abs="$(cd -- "$_adb_boot_dir/$_adb_boot_rel" && pwd && printf 'X')"
_adb_boot_abs="${_adb_boot_abs%X}"; _adb_boot_abs="${_adb_boot_abs%$'\n'}"
[ -n "$_adb_boot_abs" ] || { printf '%s: FATAL - cannot resolve this clone location.\n' "${0##*/}" >&2; exit 1; }
# ADB-BOOTSTRAP-END
REPO="$_adb_boot_abs"
# Shared shell primitives (adb_default_branch / adb_branch_sync_state) — the ONE home.
# shellcheck source=/dev/null
. "$REPO/scripts/lib/common.sh"
# bash 5.3 runtime floor (#256) — after the symlink-resolving REPO bootstrap, for the same
# reason as bin/agent-init: this command is reached through a symlink on PATH.
adb_require_bash "$@"

# Print the top comment block as --help (the shared idiom in common.sh, sourced not copied).
usage() { adb_usage "$0"; }

# Delegate the partial-skill-override composer to its library (issue #22). It operates on the
# PROJECT repo the user is in — NOT the install-source clone — so it must dispatch BEFORE the
# install-source resolution + wrong-clone guard below. The composer also installs into
# ~/.<agent>/scripts/lib, so it can equally be invoked directly there (e.g. from a project gate).
if [ "${1:-}" = "skill-compose" ]; then
  shift
  exec bash "$REPO/scripts/lib/skill-compose.sh" "$@"
fi

# Delegate the release-goal convention setup to its library (issue #27). Like skill-compose it
# operates on the PROJECT repo the user is in (resolved from the gh remote), NOT the
# install-source clone, so it must dispatch BEFORE the wrong-clone guard below. It also
# installs into ~/.<agent>/scripts/lib (the whole dir is symlinked), so it can be invoked
# directly there too.
if [ "${1:-}" = "release" ]; then
  shift
  exec bash "$REPO/scripts/lib/release-convention.sh" "$@"
fi

# Delegate the repo-settings contract to its library (issue #87) — same reasoning as the two
# above: it operates on the PROJECT repo the user is in (resolved from the gh remote), so it must
# dispatch BEFORE the wrong-clone guard, and it rides the same scripts/lib symlink into every
# agent home so `/implement-issue`'s auto-merge guard can call it directly.
if [ "${1:-}" = "repo" ]; then
  shift
  exec bash "$REPO/scripts/lib/repo-settings.sh" "$@"
fi

# Delegate the release-pinned per-project install to its library (#285) — same reasoning as the
# three above: every subcommand operates on the PROJECT the operator is standing in, so it must
# dispatch BEFORE the install-source resolution and the wrong-clone guard below, which would
# otherwise refuse a machine that has no global install at all — exactly the machine this model
# exists for.
if [ "${1:-}" = "pinned" ]; then
  shift
  exec bash "$REPO/scripts/lib/pinned-install.sh" "$@"
fi

# Delegate the adoption completion contract to its library (#81) — same reasoning as the three
# above, and one more: `status` reads the PROJECT's tracker through `gh`, resolved from the
# current directory, so dispatching after the wrong-clone guard would make it answer about the
# install-source clone instead of the repo the operator is standing in.
if [ "${1:-}" = "adopt" ]; then
  shift
  exec bash "$REPO/scripts/lib/adopt-readiness.sh" "$@"
fi

# --- discovery ---------------------------------------------------------------
#
# adb_install_source (resolve the clone the global install points into) and adb_link_into
# (the ownership test) now live in scripts/lib/common.sh, sourced above: the SessionStart
# currency hook resolves the SAME clone by the SAME rule, and two implementations of that
# rule would be exactly the drift this library exists to prevent.

# Print one installed agent token per line: each agent adb_agent_install_state calls `installed`
# or `root-doc-missing` for <src>. An update re-installs exactly this set (never install.sh's bare
# default). An EMPTY root-doc path is damage the self-heal re-links; a root-doc path holding
# anything else (`root-doc-foreign`) keeps its agent OUT of the set, because install.sh would back
# up or replace it and an unattended update never displaces an occupied path (#539).
# Returns 1 when any agent's manifest cannot be enumerated, never dropping that agent, so callers
# must capture it rather than read it through a heredoc.
# Usage: adb_installed_agents <src>
adb_installed_agents() {
  local src="$1" a st rc=0
  for a in claude codex gemini; do
    st="$(adb_agent_install_state "$a" "$src" "$HOME")" || { rc=1; continue; }
    case "$st" in installed|root-doc-missing) printf '%s\n' "$a" ;; esac
  done
  return "$rc"
}

# One stderr NOTE per agent whose root-doc path holds something other than our link while its
# other links point into <src>. Names the CLASS of the occupant, never its target or content.
# Nothing is changed: the path is the operator's until they run install.sh or uninstall.sh.
# Usage: adb_report_foreign_root_docs <src>
adb_report_foreign_root_docs() {
  local src="$1" a doc cls kept
  for a in claude codex gemini; do
    [ "$(adb_agent_install_state "$a" "$src" "$HOME" 2>/dev/null)" = root-doc-foreign ] || continue
    doc="$(adb_agent_root_doc "$a" "$src" "$HOME")" || continue
    cls="$(adb_occupant_class "$doc" "$src")"
    # adb_link moves a file or directory under the backup directory, but REPLACES a symlink with no
    # record of its target — the advice must not promise a backup the installer does not make.
    case "$cls" in
      "a link outside "*) kept="the link is replaced, and where it pointed is not kept" ;;
      *)                  kept="what is there now is moved under ~/.claude/backups/" ;;
    esac
    # The commands are printed shell-quoted (%q) so a clone path with a space can be pasted as is.
    printf "baseline: NOTE — %s is not the baseline's root doc (%s), yet %s's other links point into %s; its rules load only if that file includes them. Left untouched: \`%q --agent %s\` restores it (%s); \`%q --agent %s\` removes its other links.\n" \
      "${doc/#$HOME/\~}" "$cls" "$a" "$src" "$src/install.sh" "$a" "$kept" "$src/uninstall.sh" "$a" >&2
  done
  return 0
}

# True when the Claude Stop-hook gates are wired into settings.json. Used to preserve a
# prior `--no-hooks` choice across a self-heal (re-install would otherwise re-add them).
# True only when EVERY shipped hook is wired. Delegates to the manifest-derived predicate in
# common.sh (#242) — this used to grep for `precommit-gate.sh` alone, so removing that one hook
# read as "the operator chose --no-hooks" and silently stopped the other three from being
# maintained. Keeping the name means existing callers read the stricter answer for free.
adb_hooks_wired() { [ "$(adb_claude_hooks_state "$HOME/.claude/settings.json")" = "wired" ]; }

# Is the SANDBOX SETTINGS SURFACE (#248, D98) waiting to be installed? True when Claude is
# installed from THIS src and the receipt's disposition is one that must be RETRIED rather than
# preserved — no receipt at all (an install predating the surface), a below-floor skip, or an
# unprobeable CLI — AND the CLI now clears the floor. `skipped-optout` is the one disposition
# that is a choice, and it is never pending. `installed` has nothing to do.
#
# This exists because the `current` + links-OK path exits "nothing to do" without consulting the
# settings surface at all — the same shape as #242, where a partial hook set sailed past a
# link-only verifier. Without it, an adopter who upgrades the CLI past the floor never receives
# the settings: the one transition the whole detect-skip-say design is FOR.
# Usage: adb_settings_pending <src>
# Did the self-heal that just ran leave the protections UNAPPLIED rather than relinquished? Both
# outcomes wear a skip disposition; only the ownership rows tell them apart — a reconciliation drops
# them, a downgrade keeps every one and stops the policy being applied at all.
# Usage: adb_settings_downgraded_now <were-the-settings-pending-before> <row-count-before>
# Returns: 0 when this run should report a downgrade rather than a reconciliation
adb_settings_downgraded_now() {
  [ "${1:-0}" -eq 1 ] || return 1   # downgrade-count-free
  # THE READ IS CHECKED, and a failed one ends the run loud. Substituted straight into the `case`,
  # a receipt the just-finished heal published but this process cannot READ (a directory default
  # ACL permits the rename and denies the read) became the empty string and "not downgraded" — so
  # both update branches fell through to a benign repaired/updated result instead of exit 9, and the
  # currency wrapper that discards baseline's output suppressed the only warning. Exiting here
  # covers every caller; answering "no" is the one thing this must never do on an unread record.
  # (PR review)
  local _dd _ddrc
  _dd="$(adb_claude_settings_disposition "$(adb_claude_settings_receipt "$HOME")" 2>/dev/null)"; _ddrc=$?
  case "$_ddrc" in
    0) ;;
    20|21) adb_settings_unreadable_record "$_ddrc"; exit 1 ;;   # downgrade-read-failed
    *) return 1 ;;
  esac
  case "$_dd" in
    skipped-below-floor|skipped-unprobeable) ;;
    *) return 1 ;;
  esac
  # THE ROW COUNT IS NOT THE TEST, and using it as one lost the mixed case: a CLI that drops below
  # the floor WHILE a recorded leaf was also edited relinquishes its rows, so the counts differ and
  # the run was classified as a plain reconciliation — the operator was told ownership had been
  # tidied up and never that the protections had stopped being applied. The disposition after the
  # heal is the fact; a reconciliation that happened alongside it is reported too, not instead.
  # (PR review)
  # THE SECOND HALF CONTRADICTED THE FIRST. When a reconciliation ran alongside the downgrade the
  # rows really were dropped, so "ownership is unchanged" was false in exactly the case the line
  # above had just announced — and the promise of automatic re-application is false with it, since
  # an upgrade then meets keys nobody owns and refuses. Say which of the two happened. (PR review)
  echo "baseline: the sandbox protections are NOT being applied — the \`claude\` CLI no longer" >&2
  echo "          clears the version floor, or could not be probed (#248)." >&2
  local _nowrows
  _nowrows="$(adb_settings_row_count)" || { adb_settings_unreadable_record 20; exit 1; }   # row-count-after-failed
  if [ "${2:-0}" -gt 0 ] && [ "$_nowrows" -lt "$2" ]; then
    echo "          Stale ownership was ALSO relinquished, so the keys still in the file are no" >&2
    echo "          longer ours: upgrading will not re-apply them, and an install will refuse" >&2
    echo "          while they are there. Remove them by hand, then re-run ./install.sh." >&2
  else
    echo "          Ownership of the keys already written is unchanged; upgrade the CLI to have" >&2
    echo "          them re-applied." >&2
  fi
  return 0
}

# Did the self-heal that just ran leave the sandbox policy REFUSED? Asked of the receipt rather
# than inferred from the installer's status, which is 0 by contract for an all-or-nothing refusal.
# Usage: adb_settings_refused_now <were-the-settings-pending-before>
# Returns: 0 when the run should report a refusal rather than a plain success
# How many ownership rows does the receipt carry right now? The one fact that tells a
# RELINQUISHMENT (rows dropped) from a DOWNGRADE (rows kept, protections no longer applied) after a
# self-heal, both of which leave a skip disposition behind.
# Outputs: the count on stdout; 0 when there is no readable receipt
adb_settings_row_count() {
  local r n grc; r="$(adb_claude_settings_receipt "$HOME")"
  # A PATH THIS RUN CANNOT RESOLVE IS NOT A RECEIPT WITH NO ROWS. `-f` was false for an inaccessible
  # or dangling receipt link, and "0" then misread a downgrade as a relinquishment. (PR review)
  case "$(adb_settings_doc_state "$r")" in
    absent|empty) printf '0'; return 0 ;;
    present) ;;
    *) return 20 ;;   # row-count-unresolvable
  esac
  # `grep -c` exits 1 when the count is zero — a real answer — and 2 when the read failed, which is
  # not. `|| true` absorbed both, so an operational failure became a fabricated zero or partial count:
  # a downgrade self-heal then promised automatic re-application over a rowless receipt, or reported
  # a relinquishment that never happened, and the operator got the wrong recovery. (PR review)
  # LEAF AND SATISFIED ROWS BOTH COUNT (#462, D129): a hand-over turns a `leaf` row into a
  # `satisfied` one and relinquishes nothing, so counting leaf rows alone read it as one.
  n="$(grep -c -E "^(leaf|satisfied)$(printf '\t')" "$r" 2>/dev/null)"; grc=$?
  [ "$grc" -le 1 ] || return 20   # row-count-read-failed
  printf '%s' "$n"
}

# The receipt as it stands, as one comparable value: a self-heal that rewrote it changes this, and that
# is what makes the post-heal classification depend on THIS run rather than on a pre-heal snapshot.
# Outputs: a digest, or `none` when there is no readable receipt.
# Did THIS run leave a receipt worth classifying? The pre-heal answer alone was a stale precondition:
# the heal runs an installer that takes the settings lock only then, so an overlapping direct install
# or an operator edit can make it record a refusal — or a below-floor skip — that the earlier snapshot
# could not have seen, and gating on that snapshot reported `repaired` over it. (PR review)
# Usage: adb_settings_heal_touched <pending-before> <receipt-sig-before>
# Outputs: 1 when the receipt should be classified, 0 when nothing here changed
adb_settings_heal_touched() {
  [ "${1:-0}" -eq 1 ] && { printf '1'; return 0; }
  [ "$(adb_settings_receipt_sig)" = "${2:-none}" ] && { printf '0'; return 0; }
  printf '1'   # heal-rewrote-receipt
}

adb_settings_receipt_sig() {
  adb_sha256 "$(adb_claude_settings_receipt "$HOME")" 2>/dev/null || printf 'none'
}

adb_settings_refused_now() {
  [ "${1:-0}" -eq 1 ] || return 1
  # The same read, the same failure, and exit 7 lost the same way — see adb_settings_downgraded_now.
  local _rd _rdrc
  _rd="$(adb_claude_settings_disposition "$(adb_claude_settings_receipt "$HOME")" 2>/dev/null)"; _rdrc=$?
  case "$_rdrc" in
    0) ;;
    20|21) adb_settings_unreadable_record "$_rdrc"; exit 1 ;;   # refusal-read-failed
    *) return 1 ;;
  esac
  [ "$_rd" = skipped-blocked ] || return 1
  echo "baseline: the least-privilege sandbox settings were NOT applied — you already own one of" >&2
  echo "          the keys they ship, so the whole policy was refused (#248). Run ./install.sh in" >&2
  echo "          $SRC to see which, then remove or rename those keys and re-run it." >&2
  return 0
}

# The one diagnostic for a record neither `adb_settings_pending` nor anything downstream can
# interpret. Two remedies, because the two codes have different ones: 20 is a permission problem,
# 21 is a damaged `disposition` line that no permission change will fix.
# Usage: adb_settings_unreadable_record <20|21|22|23|24>
adb_settings_unreadable_record() {
  local receipt; receipt="$(adb_claude_settings_receipt "$HOME")"
  if [ "$1" = "24" ]; then
    echo "baseline: the sandbox fragment in the install-source could not be hashed, so it is unknown" >&2
    echo "          whether the installed policy matches it. Check that a SHA-256 tool is available" >&2
    echo "          (shasum or sha256sum) and that the clone is readable, then re-run 'baseline update'." >&2
  elif [ "$1" = "25" ]; then
    echo "baseline: a check of the sandbox ownership record could not be performed — the failure was on" >&2
    echo "          the record, not on the fragment, so it is unknown whether it lists every key it" >&2
    echo "          owns. Nothing was changed; re-run 'baseline update'." >&2
  elif [ "$1" = "23" ]; then
    # NEITHER PERMISSIONS NOR JSON. The record parses and names this clone; it simply does not list
    # every key the fragment ships, which the installer cannot produce — so it is damaged, and the
    # self-heal must not run: reconciling it discards the rows it DOES list. (PR review)
    echo "baseline: $receipt does not record every sandbox key the fragment ships, so it cannot be" >&2
    echo "          acted on safely — a repair would discard the keys it does record. Remove the" >&2
    echo "          'sandbox' block from ~/.claude/settings.json and that record, then re-run" >&2
    echo "          './install.sh' to reinstall the policy cleanly." >&2
  elif [ "$1" = "22" ]; then
    # NOT THE RECEIPT. `adb_claude_settings_leaves_intact` answers 2 when it cannot read
    # settings.json or the file is not exactly one JSON value — the receipt may be perfectly
    # valid, and sending the operator to repair its permissions cannot unblock the update.
    # (PR review)
    echo "baseline: ~/.claude/settings.json could not be read as a single JSON value, so it is" >&2
    echo "          unknown whether the sandbox settings are current. Repair that file (or its" >&2
    echo "          access) and re-run 'baseline update'; the ownership record is not the problem." >&2
  elif [ "$1" = "20" ]; then
    echo "baseline: $receipt exists but could not be READ, so it is unknown whether the sandbox" >&2
    echo "          settings are current. Fix its permissions and re-run 'baseline update'." >&2
  else
    echo "baseline: $receipt is readable but damaged: its 'disposition' line is missing or" >&2
    echo "          unrecognised, or a row in it is malformed, repeated or contradicts another (a key" >&2
    echo "          recorded as both ours and yours). No permission change will help; repair the" >&2
    echo "          record and re-run 'baseline update'. Its 'leaf' rows still name the keys we own." >&2
  fi
}

adb_settings_pending() {
  local src="$1" version receipt payload have want
  adb_agent_ours claude "$src" || return 1
  payload="$(adb_claude_settings_payload "$src")"
  [ -s "$payload" ] || return 1
  receipt="$(adb_claude_settings_receipt "$HOME")"
  # A RECEIPT THAT NAMES ANOTHER CLONE IS NEVER CURRENT, whatever its disposition says. The
  # failed-takeover state leaves this clone's root link paired with the previous clone's record,
  # and uninstall now (correctly) refuses a foreign record — so a pull that never refreshes
  # provenance leaves the keys installed and unremovable by either clone while `baseline update`
  # reports the install healthy. The installer rewrites `source` on every path it takes, so this
  # converges after one visit. (PR review)
  # THE THIRD CALL SITE OF THE SAME READER, and the same `|| true`. 1 means there is no source row
  # (a receipt written before provenance was recorded); 20 means the row could not be looked for, and
  # reading that as "no source" lets a record naming ANOTHER clone pass this guard as ours.
  # (PR review)
  local rsource _rsrc
  rsource="$(adb_claude_settings_receipt_source "$receipt" 2>/dev/null)"; _rsrc=$?
  [ "$_rsrc" -eq 20 ] && return 20   # source-unanswerable
  [ -n "$rsource" ] && [ "$rsource" != "$src" ] && return 0
  # AN UNINTERPRETABLE RECORD IS NOT AN ANSWER OF "NOT PENDING". `|| return 1` collapsed the
  # reader's 20 (unreadable) and 21 (damaged disposition) into the same status the caller reads as
  # nothing-to-do, so with every link resolving `baseline update` printed "all installed links
  # resolve — nothing to do" and exited 0 over a receipt it could not interpret: no reconciliation,
  # no diagnostic, and the one record that proves which keys are ours silently unread. Both codes
  # travel out to the caller, which fails loud. (PR review)
  local disp _disprc
  disp="$(adb_claude_settings_disposition "$receipt")"; _disprc=$?
  case "$_disprc" in
    0)     ;;
    20|21) return "$_disprc" ;;   # pending-unanswerable
    *)     return 1 ;;
  esac
  # jq IS NEEDED ONLY FROM HERE. The link, the payload, the source row and the disposition above are all
  # read without it, and returning before them let a damaged record read as not pending and a record
  # naming another clone skip the no-jq provenance refresh. (PR review)
  command -v jq >/dev/null 2>&1 || return 1   # pending-no-jq
  # EVERY DISPOSITION THAT CARRIES ROWS IS ASKED THE LIVE QUESTION, not just `installed`. A skip and
  # an opt-out deliberately keep the previous install's ownership rows, and those rows were only
  # ever rechecked inside the installer — so an operator could edit an owned leaf, run the automatic
  # update while it was divergent, restore the value later, and have uninstall delete it as ours,
  # because nothing had ever invoked the installer to relinquish. Pending ONCE is enough: self-heal
  # re-runs with `--no-sandbox` for an opt-out and re-takes the version skip otherwise, so the rows
  # are relinquished without any policy key being newly applied. (PR review)
  case "$disp" in
    installed|skipped-optout|skipped-below-floor|skipped-unprobeable)
      # 0 intact / 1 diverged / 2 UNANSWERABLE — and the third was falling through to be decided
      # on the payload digest, which cannot speak for rows nobody could compare. (PR review)
      adb_claude_settings_leaves_intact "$receipt" "$HOME/.claude/settings.json" "$payload"
      case $? in
        1) return 0 ;;
        2) return 22 ;;   # settings-unanswerable
        20|21) return $? ;;   # receipt-unreadable / receipt-damaged, NOT a settings-file fault
        23) return 23 ;;  # receipt-incomplete
        25) return 25 ;;  # receipt-check-failed: the check of the RECORD could not be performed
      esac ;;
  esac
  case "$disp" in
    none|skipped-below-floor|skipped-unprobeable) ;;
    installed|skipped-blocked)
      # NEITHER `installed` NOR A BLOCKED REFUSAL IS AUTOMATICALLY CURRENT. A plain `git pull` of the install-source clone can
      # change the fragment WITHOUT touching a single installed symlink, and this path is the only
      # thing between that pull and the fast-path `exit 0`. A refusal is recorded the same way and
      # asked the same question: it is retried when the PAYLOAD changes, not on every session —
      # re-running it each time would put `baseline update` into the repair loop that reporting
      # pending-forever already caused once. An adopter who clears the blocker re-runs
      # `./install.sh`, and the refusal message says so.
      #
      # CURRENCY IS A DIGEST QUESTION, NOT A PATH-SET ONE. Comparing owned leaf PATHS fails in both
      # directions: a leaf the operator already owned is never recorded, so the sets differ forever
      # and every session re-runs the installer and reports a repair; and changing a shipped VALUE —
      # one more domain in `allowedDomains` — leaves the path set identical, so the update never
      # applies it. The receipt records the digest of the payload it applied; compare that.
      have="$(adb_claude_settings_payload_digest "$receipt")" || return 0   # unknown -> pending once
      # 24, NOT 1. A payload that cannot be hashed — no SHA-256 backend, or a read that failed after a
      # pull changed the fragment — was answered "not pending", so with healthy links the update
      # exited 0 with "nothing to do" while it could not establish that the installed policy matched
      # the payload at all. Stale protections reported as current. (PR review)
      want="$(adb_sha256 "$payload")" || return 24   # payload-unhashable
      # A MATCHING DIGEST IS NOT THE WHOLE ANSWER. It says the payload has not changed; it says
      # nothing about the live file. An operator who edits a recorded leaf has taken the surface
      # over, and until the installer OBSERVES that it never records the ownership-free refusal —
      # so an edit made, left through an update, and later reverted by hand ended with uninstall
      # deleting the restored value as ours. Divergence is pending ONCE: the refusal it produces is
      # recorded with this same digest, so the next session is current again. "Cannot tell" is not
      # divergence, or this becomes the repair loop the comment above warns about. (PR review)
      [ "$have" = "$want" ] || return 0
      # AN INSTALLED SURFACE IS CURRENT ONLY WHILE THE CLI STILL HONOURS IT. A downgrade below the
      # floor — or a binary that stops being probeable — does not touch the payload or the live
      # file, so digest and rows both still match while the credential protections the floor exists
      # for may no longer be applied at all. Pending once: the installer records the below-floor or
      # unprobeable disposition, and that disposition then answers the version question itself, so
      # the next session is current again. `skipped-blocked` applied nothing and is not asked.
      if [ "$disp" = installed ]; then
        local _cliv; _cliv="$(adb_claude_cli_version)" || return 0
        adb_version_ge "$_cliv" "$(adb_claude_settings_floor)" || return 0
      fi
      return 1 ;;
    *) return 1 ;;
  esac
  version="$(adb_claude_cli_version)" || return 1
  adb_version_ge "$version" "$(adb_claude_settings_floor)"
}

# Report a PARTIAL hook set — and never repair it. Removing one hook's entry from settings.json is
# the DOCUMENTED way to turn that hook off (docs/installation.md: "To turn it off, remove its entry
# from ~/.claude/settings.json"), so re-wiring would destroy a supported configuration, and would
# do it repeatedly: the SessionStart currency hook survives a per-hook removal, so the next session
# would silently undo the operator's choice.
#
# #242 was never "repair a partial set" — it was that a partial set read as `--no-hooks` SILENTLY,
# so nobody could see the state or its consequence. Visibility is the fix; overruling is not, and
# this issue's own scope said so before the first attempt did the opposite.
#
# Preserving it costs nothing else: the repair runs install.sh with `--optout-if-recorded`, which
# skips exactly the removed hooks (decided under the settings lock), so a newly shipped hook is
# still wired.
# Usage: adb_report_partial_hooks <src>      (prints nothing unless the set is partial)
adb_report_partial_hooks() {
  local src="$1" settings="$HOME/.claude/settings.json"
  adb_agent_ours claude "$src" || return 0
  [ "$(adb_claude_hooks_state "$settings")" = partial ] || return 0
  # TWO SHAPES OF PARTIAL (PR #443 review). A hook whose script link exists but whose entry is
  # gone was REMOVED by the operator; a hook with neither was SHIPPED after the last install and
  # has simply not arrived yet. Only the first is an opt-out to preserve.
  if [ -z "$(adb_claude_hooks_missing_deliberate "$settings" "$src")" ]; then
    printf 'baseline: NOTE — newly shipped hook(s) not yet wired: %s\n' \
      "$(adb_claude_hooks_missing "$settings" | tr '\n' ' ')" >&2
    printf 'baseline:        No entry was removed by hand, so the next self-heal wires them.\n' >&2
    return 0
  fi
  printf 'baseline: NOTE — the hook set is PARTIAL; not wired: %s\n' \
    "$(adb_claude_hooks_missing "$settings" | tr '\n' ' ')" >&2
  printf 'baseline:        Treating that as a deliberate per-hook opt-out and leaving it alone.\n' >&2
  printf 'baseline:        Only the removed hook(s) are skipped; a newly shipped hook is still wired. Run ./install.sh to restore the full set.\n' >&2
  return 0
}

# Scan the ACTUAL installed symlinks that point INTO <src>, across ONLY the namespaces where a
# rename can leave an orphan: each agent's skills/* and scripts/* trees (Claude, Codex, and
# Antigravity/Gemini — whose skills live under ~/.gemini/config/), plus the procedure links (#434)
# in ~/.claude/rules/ and each agent's ~/.<agent>/ai-dev-baseline/. Unlike the manifest (what
# SHOULD be linked), this reports what IS linked — so a renamed-away orphan (a link into <src>
# with no current manifest entry) is visible to the pruner.
#
# Agent ROOT-DOC links (CLAUDE.md / AGENTS.md / GEMINI.md) are DELIBERATELY excluded: they live
# at fixed paths that never get renamed away, and `adb_install_source` resolves the install source
# from a (possibly dangling) root-doc link first. A dangling root doc is a genuine breakage to
# SURFACE (adb_link's guard fails the self-heal loudly), never an orphan to silently prune. NOT
# recursive: a user link deeper under ~/.claude is never in scope. A glob that matches nothing
# stays literal and is filtered by `-L`, so no `nullglob` is needed.
# Usage: adb_scan_links <src>
adb_scan_links() {
  local src="$1" p
  for p in "$HOME"/.claude/skills/* "$HOME"/.claude/scripts/* \
           "$HOME"/.claude/rules/* "$HOME"/.claude/ai-dev-baseline/* \
           "$HOME"/.codex/skills/* "$HOME"/.codex/scripts/* "$HOME"/.codex/ai-dev-baseline/* \
           "$HOME"/.gemini/config/skills/* "$HOME"/.gemini/scripts/* "$HOME"/.gemini/ai-dev-baseline/*; do
    adb_link_into "$p" "$src" && printf '%s\n' "$p"
  done
}

# Enumerate the destinations the install SHOULD have linked, straight from the shared manifest
# (adb_agent_manifest) — the SAME producer install.sh links from — for every agent installed
# FROM <src> (adb_installed_agents). One dest per line. Because create-set and verify-set share
# one producer they can't drift: a path added/moved to the manifest is both linked AND verified,
# and a missing intended link (not just a dangling one) is caught. Usage: adb_manifest_dests <src>
adb_manifest_dests() {
  local src="$1" agent manifest agents rc=0
  # CAPTURED, like the manifest below: an agent whose install state cannot be read must fail the
  # verify, not vanish from it.
  agents="$(adb_installed_agents "$src")" || rc=1
  while IFS= read -r agent; do
    [ -n "$agent" ] || continue
    # CAPTURED, NOT PIPED (#324, D64). `adb_agent_manifest … | cut -f2` reports CUT's status, so a
    # producer that refuses an unrepresentable $src/$HOME contributed zero destinations and looked
    # like an agent that simply installs nothing — and adb_verify_links then had nothing to find
    # broken. An install whose surface cannot even be enumerated must not verify as healthy.
    manifest="$(adb_agent_manifest "$agent" "$src" "$HOME")" || { rc=1; continue; }
    # `cut -f2` (TAB default) takes the <dest> column of this agent's manifest lines. `%s\n` re-adds
    # the terminator `$(…)` stripped; for an agent with no manifest that is one blank line, which
    # every reader here already skips.
    printf '%s\n' "$manifest" | cut -f2
  done <<EOF
$agents
EOF
  return "$rc"
}

# Return 0 iff every intended (manifest) install destination is OUR symlink into <src> AND
# resolves. On failure, name each broken dest on stderr — loud by design (issue #36 safety /
# issue #35 path-move fail-loud): a moved-away source (dangling link), a never-created link, OR a
# destination occupied by something that is NOT our link into the source (a real file, or a
# symlink pointing elsewhere) is surfaced, never silently tolerated. The last case matters
# because adb_link's guard deliberately leaves a pre-existing destination untouched when a source
# is missing (#48) — checking mere existence (`-e`) would then wrongly report that stale dest
# healthy and skip re-linking once the source returns (PR #51 review). Verifying the MANIFEST
# (not a scan of whatever happens to be linked) keeps verify from drifting from install.
# Usage: adb_verify_links <src>
adb_verify_links() {
  local src="$1" p broken=0 dests
  # FAIL CLOSED ON AN UNENUMERABLE SURFACE (#324, D64). This heredoc had the same swallow the
  # installers did: `$(adb_manifest_dests …)` discards the status, so a refused enumeration became
  # an empty dest list, the loop below ran zero times, and the function returned 0 — "healthy",
  # asserted about an install nothing had looked at. That is precisely the stale-state trust
  # base/practices/verify-before-asserting.md forbids: when the live state cannot be read, hold the
  # gate and surface it; never fall back to the flattering answer.
  dests="$(adb_manifest_dests "$src")" || {
    printf 'baseline: cannot enumerate the intended install destinations for %s — refusing to report this install healthy (see above)\n' \
      "$src" >&2
    return 1
  }
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    # Healthy == our symlink into src (adb_link_into) AND it resolves (-e). Anything else — a
    # dangling link, a real file, or a link pointing outside src — is BROKEN.
    if ! adb_link_into "$p" "$src" || [ ! -e "$p" ]; then
      printf 'baseline: BROKEN link (not our symlink into %s, or unresolved): %s\n' "$src" "$p" >&2
      broken=1
    fi
  done <<EOF
$dests
EOF
  return "$broken"
}

# Prune orphaned install links: a symlink in an install namespace that points INTO <src> but no
# longer resolves — the leftover a rename/removal creates (install.sh only ever adds/relinks,
# never removes; #48). STRICTLY ownership-scoped and re-checked at the moment of removal (never
# trusting the enumeration): a link is removed ONLY when it is a symlink, does NOT resolve, and
# its target is lexically inside <src>. A resolving link, a real file, or a link pointing
# elsewhere is never touched. Best-effort (always returns 0) — the subsequent adb_verify_links
# is the real gate.
#
# ONLY AN AGENT WHOSE ROOT DOC IS OUR LINK IS PRUNED (#539). For a `root-doc-missing` agent its
# dangling links may be the only evidence it is installed at all — pruning them first would turn
# it `absent` and the repair would skip it; it is pruned on the run after its repair. A
# `root-doc-foreign` agent is left exactly as it is. A state that cannot be read prunes nothing.
# Usage: adb_prune_orphans <src>
adb_prune_orphans() {
  local src="$1" p a prunable=""
  for a in claude codex gemini; do
    [ "$(adb_agent_install_state "$a" "$src" "$HOME" 2>/dev/null)" = installed ] && prunable="$prunable $a "
  done
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    case "$p" in
      "$HOME"/.claude/*) a=claude ;; "$HOME"/.codex/*) a=codex ;; "$HOME"/.gemini/*) a=gemini ;; *) continue ;;
    esac
    case "$prunable" in *" $a "*) ;; *) continue ;; esac
    [ -e "$p" ] && continue          # still resolves → legitimately installed, keep
    # Re-check ownership (symlink + target inside src) at the moment of removal, not trusting the
    # enumeration — adb_link_into re-reads the link, so this is TOCTOU-safe against a delete.
    adb_link_into "$p" "$src" && { rm -f "$p"; echo "baseline: pruned orphaned link (source renamed/removed): $p"; }
  done <<EOF
$(adb_scan_links "$src")
EOF
  return 0
}

# Re-run the idempotent installer for the ALREADY-installed agent set, preserving the
# hook preference. Never widens the install (no bare-default claude, no surprise hooks).
adb_self_heal() {
  local a _adb_dest i agents
  local -a args=() _adb_relink=()
  agents="$(adb_installed_agents "$SRC")" || {
    printf 'baseline: cannot enumerate the installed agents for %s — refusing to self-heal (see above)\n' "$SRC" >&2
    return 1
  }
  while IFS= read -r a; do
    [ -n "$a" ] || continue
    args+=(--agent "$a")
    # A root doc this run is about to re-link, so the audit line below can report what changed.
    if [ "$(adb_agent_install_state "$a" "$SRC" "$HOME")" = root-doc-missing ]; then
      _adb_dest="$(adb_agent_root_doc "$a" "$SRC" "$HOME")" && _adb_relink+=("$a" "$_adb_dest")
    fi
  done <<EOF
$agents
EOF
  if [ "${#args[@]}" -eq 0 ]; then
    # Reachable only through the `scripts/lib` fallback with every agent's root doc occupied: each
    # was reported above, and none is ours to re-install.
    echo "baseline: no agent to self-heal — every agent's root-doc path holds something that is not ours (see the NOTE above)." >&2
    return 0
  fi
  # Preserve a prior hook opt-out: only when Claude is installed FROM THIS src (adb_agent_ours — a
  # missing root doc still counts, so the repair keeps every recorded opt-out; an occupied one does
  # not, and is not ours to re-wire). THREE states (#242), and removing a hook's entry is the
  # documented way to disable it (docs/installation.md) whether you remove one or all:
  #   none     every entry removed — indistinguishable from an `install.sh --no-hooks` install, so it
  #            keeps `--no-hooks` and no hook is wired, a newly shipped one included;
  #   partial  some removed — install.sh skips exactly those (`--optout-if-recorded`, below) and
  #            wires the rest, so a newly shipped hook arrives and the opt-outs stay;
  #   wired    nothing to preserve.
  # The settings opt-out is EXPLICIT, not inferred (D98): `--no-sandbox` recorded a disposition,
  # and re-passing the flag is what keeps honouring it. Absence of the keys is deliberately NOT
  # the signal — four different causes produce it, and only this one is a choice.
  # ASKED BY THE CHILD, UNDER THE SETTINGS LOCK. Read here it is already stale by the time the installer
  # acquires that lock: a direct `install.sh --no-sandbox` landing in between recorded the choice and
  # this self-heal applied the fragment straight over it. The flag says "honour a recorded opt-out", and
  # the installer re-reads the disposition once it holds the lock. (PR review) The per-hook opt-outs are
  # read there for the same reason: `--skip-hook` names computed here could be stale by then.
  if adb_agent_ours claude "$SRC"; then
    args+=(--optout-if-recorded)   # optout-revalidated-by-child
  fi
  if adb_agent_ours claude "$SRC"; then
    case "$(adb_claude_hooks_state "$HOME/.claude/settings.json")" in
      none)
        # `none` is the honoured opt-out only when the operator REMOVED the entries — their
        # script links are still ours. No entries AND no owned links is an install that never
        # wired at all (a first install without jq takes its fresh links back), and `--no-hooks`
        # here kept it unwired through every self-heal after jq arrived. (PR #443 review)
        [ -z "$(adb_claude_hooks_missing_deliberate "$HOME/.claude/settings.json" "$SRC")" ] || args+=(--no-hooks) ;;
      partial) adb_report_partial_hooks "$SRC" ;;
      *) : ;;   # wired — nothing to preserve, nothing to say
    esac
  fi
  echo "baseline: self-healing installed links → ./install.sh ${args[*]}"
  # THE STATUS IS KEPT, NOT RETURNED HERE: a later agent failing after Claude's root doc was
  # re-linked must not skip the audit of that re-link below.
  local irc=0
  ( cd "$SRC" && ./install.sh "${args[@]}" ) || irc=$?
  [ "$irc" -eq 0 ] || echo "baseline: install.sh exited non-zero — inspect its output above (path move? see issue #35)." >&2
  # ONE AUDIT LINE PER ROOT DOC THAT IS NOW OURS AND RESOLVES — asked of the filesystem after the
  # installer, never inferred from its status.
  for (( i = 0; i < ${#_adb_relink[@]}; i += 2 )); do
    _adb_dest="${_adb_relink[$((i + 1))]}"
    if adb_link_into "$_adb_dest" "$SRC" && [ -e "$_adb_dest" ]; then
      printf "baseline: re-linked %s — it was missing while %s's other links still point into %s.\n" \
        "${_adb_dest/#$HOME/\~}" "${_adb_relink[$i]}" "$SRC" >&2
    fi
  done
  [ "$irc" -eq 0 ] || return 1
  return 0
}

# --- state -------------------------------------------------------------------
#
# adb_clone_local_state (no-network classification) and adb_clone_status (that, plus the
# fetched-refs comparison) also live in scripts/lib/common.sh — the SessionStart hook needs
# the same words to decide what to report.

# --- update serialization ----------------------------------------------------
#
# The mutating path (pull + prune + install.sh) must not run twice at once. That was already
# possible by hand (two terminals), and the SessionStart hook makes it LIKELY: several sessions
# can start within the same second and each would race the others through `git pull` and a
# settings.json rewrite. A directory is the portable test-and-set (macOS has no flock(1)), taken with `adb_mkdir_excl`
# because a bare `mkdir` is not exclusive under uutils (D105).
#
# Stale-lock recovery is by AGE, not by liveness: a pid check cannot distinguish "that pid died"
# from "that pid was recycled", and the failure we are protecting against is a killed updater
# (the hook's own harness timeout can do exactly that), not a wedged one. The bound is generous
# because a legitimate pull + full re-install is seconds, not minutes.
# The update lock lives in `scripts/lib/common.sh` — `adb_update_lock` / `adb_update_unlock`.
# It moved there when install.sh needed the same mutual exclusion for the settings surface, and a
# second copy of a lock is two locks that do not exclude each other.

# --- argument parsing --------------------------------------------------------

ACTION=""
CHECK=0
while [ $# -gt 0 ]; do
  case "$1" in
    update)      ACTION=update; shift ;;
    --check)     CHECK=1; shift ;;
    -h|--help)   usage; exit 0 ;;
    *) echo "baseline: unknown argument '$1'" >&2; echo >&2; usage >&2; exit 2 ;;
  esac
done
if [ "$ACTION" != "update" ]; then
  echo "baseline: expected a subcommand ('update', 'skill-compose', 'release', 'repo', 'adopt', or 'pinned')" >&2; echo >&2; usage >&2; exit 2
fi

# --- resolve the install-source clone ----------------------------------------

if ! SRC="$(adb_install_source)"; then
  echo "baseline: no installed baseline detected — no ~/.<agent> root-doc or ~/.<agent>/scripts/lib symlink points into a clone." >&2
  echo "          Nothing to keep current. Run install.sh from your baseline clone first." >&2
  exit 3
fi

# Guard the two-clone split: only ever update the clone the install points into. If
# baseline was invoked from a DIFFERENT clone (e.g. a dev checkout), refuse loudly
# rather than silently updating the wrong tree. `-ef` compares by device+inode (following
# symlinks), so the same clone reached via two path spellings is correctly seen as one;
# only genuinely distinct directories refuse.
if ! [ "$SRC" -ef "$REPO" ]; then
  echo "baseline: the global install points at the clone" >&2
  echo "            $SRC" >&2
  echo "          but you invoked baseline from" >&2
  echo "            $REPO" >&2
  echo "          Run 'baseline update' from the install-source clone above — that is the" >&2
  echo "          clone whose git state feeds every project. (A dev clone is kept current" >&2
  echo "          by /implement-issue's preflight auto-sync instead.)" >&2
  exit 4
fi

DEFAULT="$(adb_default_branch "$SRC")"

# --- classify locally, THEN fetch --------------------------------------------
#
# Order matters twice over. A clone that is dirty / mid-rebase / detached / on a feature branch
# will be refused no matter what origin says, so asking origin first is pure cost — and it is
# not free of side effects either: `git fetch` writes remote-tracking refs and FETCH_HEAD, which
# `--check` documents itself as never doing. Classifying local state first makes `--check`
# honest for exactly the states it refuses, and keeps the SessionStart hook off the network on
# every session started from an unsafe clone.

STATUS="$(adb_clone_local_state "$SRC" "$DEFAULT")"
if [ "$STATUS" = "local-ok" ]; then
  if ! git -C "$SRC" fetch --quiet origin 2>/dev/null; then
    [ "$CHECK" -eq 1 ] && echo "fetch-failed"
    echo "baseline: 'git fetch' failed in $SRC (offline?) — cannot determine currency." >&2
    exit 30
  fi
  STATUS="$(adb_branch_sync_state "$SRC" "$DEFAULT")"
fi

# --- --check: report only, mutate nothing ------------------------------------

if [ "$CHECK" -eq 1 ]; then
  echo "$STATUS"
  case "$STATUS" in
    current)                                exit 0  ;;
    behind)                                 exit 10 ;;
    dirty|ahead|diverged|detached|not-default|in-progress) exit 20 ;;
    *)                                      exit 30 ;;   # no-remote | not-a-repo
  esac
fi

# A PINNED PROJECT IS TOLD, and the global update still runs. The two models are independent:
# this command's subject is the install-source clone, and a project vendoring its own payload
# neither blocks nor is served by keeping that clone current — so the notice is purely additive.
#
# `--check-latest`, because #285 asks `baseline update` to REPORT a newer release for a pinned
# project. This is the mutating path, which has already fetched, so the extra read costs a pinned
# project one call and a global one nothing (the notice exits immediately when no pin says
# `mode = "pinned"`). It never upgrades: naming the version is the approval, and the two automatic
# callers of this command must never be able to express one.
#
# AFTER `--check` returns, so that predicate stays exactly what it documents — one status word on
# stdout, no changes, and no network it did not already need.
bash "$REPO/scripts/lib/pinned-install.sh" notice --check-latest || true

# --- serialize the mutating path ---------------------------------------------
#
# Taken AFTER classification (a read-only run needs no lock) and BEFORE any mutation. When
# another update holds it, exit 5 rather than waiting: the caller is either a human who can
# re-run, or the SessionStart hook, which must not stall a session behind a peer's pull.
#
# Refuse a non-repo BEFORE the lock rather than at the ladder below, because the lock path is
# derived from the git dir: interpolating an unresolvable one would yield the bare path
# "/adb-update.lock" and try to write at the filesystem ROOT.
if [ "$STATUS" = "not-a-repo" ] || ! GITDIR="$(git -C "$SRC" rev-parse --absolute-git-dir 2>/dev/null)" \
   || [ -z "$GITDIR" ]; then
  echo "baseline: cannot determine currency for $SRC — not a git repository." >&2
  exit 30
fi
UPDATE_LOCK="$GITDIR/adb-update.lock"
if ! adb_update_lock "$UPDATE_LOCK"; then
  echo "baseline: another 'baseline update' is running for $SRC — skipping this one." >&2
  # Name the lock. A SIGKILLed updater (the SessionStart hook's own harness timeout is the
  # likeliest cause) leaves one behind, and without this the message claims a running process
  # that does not exist and gives no way out.
  echo "          If nothing is actually running, remove: $UPDATE_LOCK" >&2
  exit 5
fi
# Release on ANY exit path, including a signal — but only if we still own it (adb_update_unlock).
trap 'adb_update_unlock "$UPDATE_LOCK"' EXIT
trap 'adb_update_unlock "$UPDATE_LOCK"; exit 143' TERM
trap 'adb_update_unlock "$UPDATE_LOCK"; exit 130' INT

# Re-classify under the lock: between the read above and this point a peer update may have
# already pulled (so `behind` became `current`), or the operator may have started editing (so
# `local-ok` became `dirty`). Acting on the pre-lock reading would be exactly the stale-state
# trust base/practices/verify-before-asserting.md forbids. The fetch above already ran, so this
# needs no network — only the composed classification.
STATUS="$(adb_clone_status "$SRC" "$DEFAULT")"

# --- update ------------------------------------------------------------------

case "$STATUS" in
  current)
    echo "baseline: install-source already current ($SRC on $DEFAULT, up to date with origin)."
    adb_report_foreign_root_docs "$SRC"
    # Prune renamed-away orphans first (a prior manual `git pull` may have left one), THEN verify
    # the manifest — so a leftover from a rename doesn't force a needless "broken" repair (#48).
    adb_prune_orphans "$SRC"
    # TWO questions, not one — "is the installed surface what it should be?" has a symlink half
    # and a hook-wiring half, and this path used to ask only the first (#242). A hook missing from
    # settings.json is not a broken link, so `partial` sailed past `adb_verify_links` and exited
    # "nothing to do" without ever consulting it. That made the three-state classifier correct and
    # unreachable on the common path: install current, links fine, hook set partial.
    #
    # Only `partial` triggers repair. `none` is the honoured opt-out (the operator removed them
    # all), and `wired` has nothing to do. The Claude-installed-from-THIS-src guard mirrors
    # adb_self_heal's: a root doc pointing at another clone is not ours to re-wire.
    LINKS_OK=0; adb_verify_links "$SRC" && LINKS_OK=1
    adb_report_partial_hooks "$SRC"
    # THREE questions now, not two (#248). The sandbox settings can be pending while every link
    # resolves and every hook is wired — that is exactly the state a below-floor install leaves,
    # and the CLI upgrade that clears it moves nothing this path was looking at.
    # NON-ZERO IS NO LONGER ONE ANSWER. 20/21 mean the ownership record could not be interpreted,
    # and reporting a healthy install over it is the failure this asks about. (PR review)
    SETTINGS_PENDING=0; adb_settings_pending "$SRC"; SPRC=$?
    case "$SPRC" in
      0)     SETTINGS_PENDING=1 ;;
      2[0-9]) adb_settings_unreadable_record "$SPRC"; exit 1 ;;   # pending-unanswerable-current
    esac
    SETTINGS_ROWS_BEFORE="$(adb_settings_row_count)" || { adb_settings_unreadable_record 20; exit 1; }   # row-count-before-current
    SETTINGS_SIG_BEFORE="$(adb_settings_receipt_sig)"   # sig-before-current
    if [ "$LINKS_OK" -eq 1 ] && [ "$SETTINGS_PENDING" -eq 0 ]; then
      echo "baseline: all installed links resolve — nothing to do."
      exit 0
    fi
    if [ "$LINKS_OK" -eq 1 ]; then
      echo "baseline: links are current, but the least-privilege sandbox settings are not applied yet (#248) — installing them …"
    else
      echo "baseline: an installed path is broken though up to date — repairing …"
    fi
    adb_self_heal && adb_verify_links "$SRC" || { echo "baseline: repair failed — see above." >&2; exit 1; }
    # A SUCCESSFUL INSTALLER RUN IS NOT THE SAME AS A REPAIR. When the sandbox settings were the
    # thing pending and the operator already owns one of the shipped keys, the all-or-nothing
    # contract makes `install.sh` write `skipped-blocked` and return 0 — nothing was applied, and
    # printing "repaired" turned a security-relevant refusal into a success line. It is invisible
    # in the automatic SessionStart flow, which suppresses the installer's own output and renders
    # exit 6 as "repaired the installed links". Ask the receipt what actually happened rather than
    # inferring it from the installer's status. (PR review)
    # PROPAGATED FROM EVERY SELF-HEAL, not only the one that had nothing else to do. Gating this on
    # `LINKS_OK` meant a run that ALSO repaired a broken link fell through to "repaired." and exit 6
    # — and the SessionStart caller suppresses the installer's own output, so the refusal vanished
    # behind a success line precisely when something else had gone wrong too. The refusal outranks
    # the repair in what it must tell the operator; the message carries both facts. (PR review)
    if adb_settings_refused_now "$(adb_settings_heal_touched "$SETTINGS_PENDING" "$SETTINGS_SIG_BEFORE")"; then
      [ "$LINKS_OK" -eq 1 ] || echo "baseline: repaired the installed links." >&2
      exit 7
    fi
    # A RECONCILIATION IS NOT A REPAIR. Divergent rows under a skip or an opt-out make the settings
    # pending so the installer can relinquish them — and the receipt keeps that skip disposition, so
    # the blocked check above does not fire and this fell through to "repaired." for a run in which
    # no link and no setting was changed. Gated on `LINKS_OK` unlike the refusal above, and the
    # difference is deliberate: with a broken link there really was a repair, whereas a refusal is
    # security-relevant and must be said whatever else happened. (PR review)
    # A DOWNGRADE IS REPORTED WHATEVER ELSE HAPPENED, and that is the opposite of the line below it.
    # The reconciliation report is gated on `LINKS_OK` because with a broken link there really was a
    # repair, so "repaired" is true and the reconciliation is only a matter of accuracy. A downgrade
    # is not: the protections have stopped being applied, and a run that also fixed a link would
    # have reported exit 6 and let the SessionStart wrapper render it as repaired links alone.
    # Same rule as the refusal above — a security-relevant fact does not wait its turn. (PR review)
    adb_settings_downgraded_now "$(adb_settings_heal_touched "$SETTINGS_PENDING" "$SETTINGS_SIG_BEFORE")" "$SETTINGS_ROWS_BEFORE" && {
      [ "$LINKS_OK" -eq 1 ] || echo "baseline: repaired the installed links." >&2
      exit 9
    }
    if [ "$SETTINGS_PENDING" -eq 1 ] && [ "$LINKS_OK" -eq 1 ]; then
      case "$(adb_claude_settings_disposition "$(adb_claude_settings_receipt "$HOME")" 2>/dev/null)" in
        skipped-optout|skipped-below-floor|skipped-unprobeable)
          # RELINQUISHED MEANS ROWS DROPPED, which is the same question the downgrade classifier asks.
          # A skip whose only change was the provenance row still owns every leaf it names, so
          # reporting it as relinquished tells the operator protection was given up when none was.
          # (PR review)
          SETTINGS_ROWS_AFTER="$(adb_settings_row_count)" || { adb_settings_unreadable_record 20; exit 1; }   # row-count-after-heal
          if [ "$SETTINGS_ROWS_AFTER" -lt "$SETTINGS_ROWS_BEFORE" ]; then
            echo "baseline: relinquished stale sandbox ownership; no link or setting was changed."
          else
            echo "baseline: refreshed the sandbox ownership record; no link or setting was changed."
          fi
          exit 8 ;;
      esac
    fi
    echo "baseline: repaired."
    # Exit 6, not 0: a repair CHANGED the installed surface without moving HEAD, and a caller that
    # infers "something changed" from the HEAD delta would miss it entirely. The SessionStart hook
    # does exactly that, and would leave a skill it had just restored unavailable for the session.
    # A success code distinct from "nothing to do" is the machine-readable way to say so — the
    # alternative is parsing this prose, which is precisely what the exit-code contract avoids.
    exit 6
    ;;
  behind)
    echo "baseline: updating $SRC ($DEFAULT is behind origin) …"
    if ! git -C "$SRC" pull --ff-only --quiet origin "$DEFAULT"; then
      echo "baseline: 'git pull --ff-only' failed — resolve manually in $SRC (never force-pulled)." >&2
      exit 20
    fi
    # Prune renamed-away orphans only AFTER a successful pull (never mutate the install if the
    # pull failed), then re-run the idempotent installer. install.sh links each skill and script
    # as its OWN destination, so a pulled commit that ADDS a skill/script needs a new symlink even
    # though every pre-existing link still resolves — "links resolve" does NOT imply "all payloads
    # linked." The installer is idempotent (unchanged links are a no-op); prune removes the links
    # a rename left dangling that the installer would otherwise never clean up.
    echo "baseline: pulled to origin/$DEFAULT; pruning orphaned links + re-running the idempotent installer …"
    adb_report_foreign_root_docs "$SRC"
    adb_prune_orphans "$SRC"
    # ASKED AFTER THE PULL, so the payload compared is the one just pulled — a `git pull` that
    # changes the fragment is exactly how this path acquires pending settings in the first place.
    BEHIND_SETTINGS_PENDING=0; adb_settings_pending "$SRC"; BSPRC=$?
    case "$BSPRC" in
      0)     BEHIND_SETTINGS_PENDING=1 ;;
      2[0-9]) adb_settings_unreadable_record "$BSPRC"; exit 1 ;;   # pending-unanswerable-behind
    esac
    BEHIND_ROWS_BEFORE="$(adb_settings_row_count)" || { adb_settings_unreadable_record 20; exit 1; }   # row-count-before-behind
    BEHIND_SIG_BEFORE="$(adb_settings_receipt_sig)"   # sig-before-behind
    if adb_self_heal && adb_verify_links "$SRC"; then
      # ...and a refusal is reported here too. This branch exited 0 on any successful heal, so an
      # update that also refused the policy was rendered as a plain `updated` with the installer's
      # own output suppressed. The clone really did advance, and the message says so — but the
      # refusal is what the operator needs to see, so it chooses the code.
      if adb_settings_refused_now "$(adb_settings_heal_touched "$BEHIND_SETTINGS_PENDING" "$BEHIND_SIG_BEFORE")"; then
        echo "baseline: the clone WAS updated and every link resolves; only the settings were refused." >&2
        exit 7
      fi
      # AND THE DOWNGRADE, for the same reason the refusal is asked here: this branch exited 0 on
      # any successful heal, so an update that also lost the protections was rendered as a plain
      # `updated` with the installer's own warning suppressed.
      if adb_settings_downgraded_now "$(adb_settings_heal_touched "$BEHIND_SETTINGS_PENDING" "$BEHIND_SIG_BEFORE")" "$BEHIND_ROWS_BEFORE"; then
        echo "baseline: the clone WAS updated and every link resolves." >&2
        exit 9
      fi
      echo "baseline: update complete."
      exit 0
    fi
    echo "baseline: self-heal left a broken link — this is loud on purpose (see issue #35)." >&2
    exit 1
    ;;
  dirty)
    echo "baseline: install-source tree is dirty — skipping (never auto-pulls over uncommitted work)." >&2
    echo "          Commit or stash in $SRC, then re-run 'baseline update'." >&2
    exit 20
    ;;
  in-progress)
    echo "baseline: install-source has a merge/rebase/cherry-pick/bisect in progress — skipping." >&2
    echo "          $SRC" >&2
    echo "          Finish or abort that operation, then re-run 'baseline update'." >&2
    exit 20
    ;;
  ahead|diverged|detached|not-default)
    echo "baseline: install-source is '$STATUS' on inspection — needs attention, not auto-pulling." >&2
    echo "          $SRC" >&2
    echo "          Reconcile it manually (the install-source clone should sit clean on $DEFAULT)." >&2
    exit 20
    ;;
  *)
    echo "baseline: cannot determine currency (status '$STATUS') for $SRC." >&2
    echo "          Is 'origin/$DEFAULT' present? Check the remote and re-run." >&2
    exit 30
    ;;
esac
