#!/usr/bin/env bash
# ai-dev-baseline — per-project initializer.
#
# Run ANYWHERE inside a project's repo (it resolves the git root itself). Sets up this
# project's agent role manifest and the runtime state gitignore, then prints the effective
# role map. The global install already makes the skills + gates available everywhere; this
# is the lightweight per-project layer (base/practices/00-index.md: project overrides global).
#
# Repo-shape tolerant (#23): it resolves the git root even when called from a subdirectory, and
# surfaces a non-tidy shape — a repo nested inside an untracked parent tree, an out-of-repo root
# doc referenced by relative path, a monorepo/layered layout — instead of silently operating on
# the wrong root. It only ever initializes the resolved git root.
#
# Usage: agent-init [--force]     (--force overwrites an existing agents.toml)

set -uo pipefail

# Locate the installed baseline repo (this script lives in <repo>/bin/agent-init;
# when symlinked onto PATH, resolve through the link).
_adb_boot_src="${BASH_SOURCE[0]}"
# ADB-SYMWALK-BEGIN (#343) — BYTE-IDENTICAL IN bin/baseline AND bin/agent-init; pinned by
# scripts/check-bootstrap.sh. A relative symlink target resolves against the LINK's own directory,
# not the caller's cwd. `readlink -n` is what makes the walk lossless — plain `readlink` appends a
# newline on GNU but NOT when the target already ends in one on BSD, so the two are indistinguishable
# there and no sentinel can recover the difference; `-n` emits the target raw on both.
while [ -L "$_adb_boot_src" ]; do
  _adb_boot_link="$(readlink -n -- "$_adb_boot_src" && printf 'X')"; _adb_boot_link="${_adb_boot_link%X}"
  case "$_adb_boot_link" in
    /*) _adb_boot_src="$_adb_boot_link" ;;
    *)  _adb_boot_dir="${_adb_boot_src%/*}"
        if [ "$_adb_boot_dir" = "$_adb_boot_src" ]; then _adb_boot_dir="."; elif [ -z "$_adb_boot_dir" ]; then _adb_boot_dir="/"; fi
        _adb_boot_src="$_adb_boot_dir/$_adb_boot_link" ;;
  esac
done
# ADB-SYMWALK-END
_adb_boot_rel=".."
# ADB-BOOTSTRAP-BEGIN (#343) — BYTE-IDENTICAL IN EVERY ENTRY POINT; pinned by scripts/check-bootstrap.sh,
# which carries why each line is shaped this way. Lossless because `$(…)` strips every trailing newline:
# `${src%/*}` cannot strip, and the `X` sentinel bounds what the `pwd` capture can. Logical `pwd` (not
# `-P`) preserves how install.sh records its symlink targets. bash 3.2-safe: this runs before the gate.
_adb_boot_dir="${_adb_boot_src%/*}"
if [ "$_adb_boot_dir" = "$_adb_boot_src" ]; then _adb_boot_dir="."; elif [ -z "$_adb_boot_dir" ]; then _adb_boot_dir="/"; fi
_adb_boot_abs="$(cd -- "$_adb_boot_dir/$_adb_boot_rel" && pwd && printf 'X')"
_adb_boot_abs="${_adb_boot_abs%X}"; _adb_boot_abs="${_adb_boot_abs%$'\n'}"
[ -n "$_adb_boot_abs" ] || { printf '%s: FATAL - cannot resolve this clone location.\n' "${0##*/}" >&2; exit 1; }
# ADB-BOOTSTRAP-END
REPO="$_adb_boot_abs"
# Shared shell primitives (adb_toml_get) — the ONE home, sourced not copied.
# shellcheck source=/dev/null
. "$REPO/scripts/lib/common.sh"
# bash 5.3 runtime floor (#256). Placed after the symlink-resolving REPO bootstrap above rather
# than before it: this command is installed onto PATH via a symlink, so `dirname "$0"` alone
# does not find the clone. Still before any cd or argument shift.
adb_require_bash "$@"

FORCE=0
[ "${1:-}" = "--force" ] && FORCE=1

# Resolve the project root shape-tolerantly (#23) via the shared primitive — the ONE home for
# the resolution; read its facts via the shared adb_shape_val/adb_shape_all accessors. Here we
# only SURFACE what it finds, then initialize the resolved git root.
shape="$(adb_repo_shape "$PWD")"

# Surface any diagnostics first, so a warning (e.g. an unreadable start) is shown BEFORE — and
# gives the real reason for — a refusal below, rather than being stranded after the exit path.
adb_shape_all "$shape" warning | while IFS= read -r m; do
  echo "warning: $m" >&2
done

# REFUSE AN ABSENT ROOT EXPLICITLY, AND BEFORE THE in_git CHECK (#278, D59). `adb_repo_shape`
# answers a path it cannot represent in its record format with a `warning` and NO facts at all —
# printed just above, so the operator already has the reason. This branch turns that into a
# refusal.
#
# IT IS CHECKED FIRST because the in_git test cannot speak for this case: with no facts emitted,
# `in_git` is EMPTY, which is `!= "1"`, so the run would exit reporting "not inside a git repo"
# about a directory that is a perfectly good git repo. A wrong reason sends the operator to run
# `git init` in a repo that has one.
#
# AND IT IS ITS OWN TEST rather than a job left to `cd "$ROOT"` below, which only LOOKS like it
# would catch this. `cd ""` is not portable: bash **5.3** rejects it ("null directory") — the
# release that changed this, not 5.x generally — while bash 3.2, still the /bin/bash on every
# macOS, SUCCEEDS and silently stays put, which would write agents.toml into whatever directory
# the operator happened to be in. This project pins a 5.3 floor, so today that fallback does
# refuse; it refuses by accident, with an empty path in its message, and an accident is not a
# guard. Measured here: 3.2.57 returns 0 and stays, 5.3.15 returns non-zero.
ROOT="$(adb_shape_val "$shape" root)"
if [ -z "$ROOT" ]; then
  echo "ERROR: refusing to initialize — this path cannot be represented in the repo-shape record" >&2
  echo "  format, so the root it resolves to cannot be trusted (see the warning above)." >&2
  echo "  A directory name containing a TAB or a NEWLINE is not supported: the record splits and" >&2
  echo "  the parsed root silently becomes a DIFFERENT directory, which agent-init would then" >&2
  echo "  write into. Rename the directory and run agent-init again." >&2
  exit 1
fi

if [ "$(adb_shape_val "$shape" in_git)" != "1" ]; then
  echo "ERROR: not inside a git repo — agent-init is a per-project initializer for a git repo." >&2
  echo "  Run it anywhere inside your project's repo (it resolves the git root itself), or" >&2
  echo "  'git init' this directory first if it really is a standalone project." >&2
  exit 1
fi

# Surface any non-tidy repo shape BEFORE writing anything, so the operator sees exactly what
# agent-init can and cannot manage. None of these are errors — but agent-init must never pretend
# a wider project is invisible, nor operate on the wrong root. It reports facts and asks the
# operator to confirm the boundary; it never claims to know the "real" project extent.
[ "$(adb_shape_val "$shape" cwd_is_root)" = "0" ] && \
  echo "note: working dir is below the git root — initializing at the git root: $ROOT"

nested="$(adb_shape_val "$shape" nested_in)"
[ -n "$nested" ] && \
  echo "note: this repo is NESTED inside another git repo at $nested — that outer repo is out of scope here; agent-init manages only $ROOT."

foreign_docs="$(adb_shape_all "$shape" foreign_doc)"
if [ -n "$foreign_docs" ]; then
  printf '%s\n' "$foreign_docs" | while IFS= read -r d; do
    echo "note: found a root doc OUTSIDE this repo at $d — referenced by relative path but invisible to git-aware tooling; agent-init won't read or manage it."
  done
  # An out-of-repo doc above a repo whose parent is in no git repo is evidence this repo sits
  # inside a larger, untracked tree. Report the fact and ask; don't assert the project's extent.
  [ "$(adb_shape_val "$shape" parent_in_git)" = "0" ] && \
    echo "note: the git root's parent is outside any git repo — this repo may sit inside a larger, untracked project tree. Confirm which root your work maps to; agent-init initializes only the git root."
fi

adb_shape_all "$shape" extra_doc | while IFS= read -r d; do
  echo "note: found another project root doc in-tree at $d — this looks like a monorepo/layered layout; agent-init initializes only the top-level git root ($ROOT)."
done

trunc="$(adb_shape_val "$shape" scan_truncated)"
[ -n "$trunc" ] && \
  echo "note: stopped scanning parent directories after $trunc levels — if your project root is higher up, run agent-init closer to it."

cd "$ROOT" || { echo "ERROR: cannot cd to repo root: $ROOT" >&2; exit 1; }

# 1. Role manifest
if [ -f agents.toml ] && [ "$FORCE" -eq 0 ]; then
  echo "agents.toml exists (use --force to overwrite)"
else
  cp "$REPO/templates/agents.toml" agents.toml
  echo "wrote agents.toml — edit [roles] to set who is primary / reviews / debugs"
fi

# 2. Ensure runtime state is gitignored — for EVERY rendered agent, not just Claude (#250).
#
# This used to add `.claude/state/` alone, which was adequate while the only thing a state dir held
# was a marker file naming a branch. It is not adequate now: /implement-issue step 2 writes the
# ISSUE SNAPSHOT there — the untrusted issue body, every comment, and the `author_association`
# provenance label — and `{{STATE_DIR}}` renders PER AGENT (`.claude/state`, `.codex/state`,
# `.gemini/state`). A Codex or Gemini run therefore dropped that content into the working tree as an
# UNTRACKED file, one `git add -A` away from being committed. Before #250 the snapshot lived outside
# the repo entirely, so moving it in is what created the exposure.
#
# THE SET IS DERIVED FROM `agents/<token>/`, the same tree scripts/build.sh renders into and the one
# docs/adding-an-agent.md says you add — never a second hardcoded list that a fourth agent would
# silently fall out of.
for _adb_agent_dir in "$REPO"/agents/*/; do
  [ -d "$_adb_agent_dir" ] || continue
  _adb_agent="${_adb_agent_dir%/}"; _adb_agent="${_adb_agent##*/}"
  _adb_state=".$_adb_agent/state/"
  # Anchored, so a comment mentioning the path does not read as a rule. A WIDER existing rule
  # (`.claude/`) is deliberately not detected: over-adding a redundant line is harmless, whereas a
  # clever match that guessed wrong would leave untrusted issue text tracked.
  if [ -f .gitignore ] && grep -qF -- "$_adb_state" .gitignore 2>/dev/null; then
    continue
  fi
  printf '\n# ai-dev-baseline runtime state (%s)\n%s\n' "$_adb_agent" "$_adb_state" >> .gitignore
  echo "added $_adb_state to .gitignore"
done
unset _adb_agent_dir _adb_agent _adb_state
mkdir -p .claude/state

# 3. Show the effective role map — the FULL repo → global default → built-in resolution, via the
#    runtime helper (scripts/lib/role-dispatch.sh is the single source for the order, #15).
echo ""
echo "Effective roles for this repo:"
RD="$REPO/scripts/lib/role-dispatch.sh"
# A role names an agent; it does not prove that agent can RUN here. `agent-init` is the one place
# an operator sees the map before a workflow depends on it, so it is where "assigned but its CLI
# is not installed" should surface — at setup, cheaply, rather than mid-run after a branch and a
# commit (#211). Deliberately ANNOTATION, never a verdict: an absent CLI is not an error here, and
# agent-init does not exit nonzero for one. It also claims no more than it checked — `available`
# answers "on PATH", not authenticated, configured, or working.
annotate_cli() {
  local token="$1"
  bash "$RD" available "$token" >/dev/null 2>&1
  case "$?" in
    0) printf '' ;;                       # installed: the normal case says nothing
    1) printf ' [CLI not installed]' ;;
    *) printf '' ;;                       # not an agent token — `resolve` already validated it
  esac
}
show_role() {
  local key="$1" v rc out t
  # `resolve` prints the token(s) (a `review` list is joined with commas); empty output with a
  # 0 status is a legitimate skip; a nonzero status is a manifest error (whose message it already
  # printed to stderr above).
  v="$(bash "$RD" resolve "$key")"; rc=$?
  if [ "$rc" -ne 0 ]; then
    printf '  %-13s %s\n' "$key" "(invalid — see the error above)"
  elif [ -z "$v" ]; then
    printf '  %-13s %s\n' "$key" "(unassigned — skipped)"
  else
    # Annotate PER TOKEN, not per role: a `review` list can be half-installed, and a single
    # trailing note on the joined line could not say which half.
    out=""
    while IFS= read -r t; do
      [ -n "$t" ] || continue
      [ -z "$out" ] || out="$out, "
      out="$out$t$(annotate_cli "$t")"
    done <<EOF
$v
EOF
    printf '  %-13s %s\n' "$key" "$out"
  fi
}
show_role primary
show_role gap_analysis
show_role review
show_role debug
show_role issue_author
show_role release
echo ""

# --- which REVIEW RUNG is this project on? (#211) ----------------------------------------------
# The role map above says who is ASSIGNED. This says what will actually REVIEW A DIFF, which is a
# different question and the one an operator is really asking.
#
# THE LADDER IS NOT RE-DERIVED HERE. `role-dispatch.sh review-rung` owns it, and /implement-issue
# step 8 asks the same predicate — because the alternative was tried and failed inside this very
# change: both sides interpreted `resolve` + `available` + the bot allowlist themselves and
# immediately disagreed about WHICH bot reader decides the deferred rung. This block therefore
# formats an answer; it does not compute one.
# NO DRIVER ARGUMENT, deliberately: `agent-init` reports the manifest's CONFIGURED shape, not a
# live run, so the predicate compares against `primary`. The workflow passes its own agent token
# instead, because "independent" means "not the model that actually wrote the diff".
RUNG_LINE="$(bash "$RD" review-rung 2>/dev/null)" || true
RUNG="${RUNG_LINE%% *}"
RUNG_DETAIL=""
case "$RUNG_LINE" in *' '*) RUNG_DETAIL="${RUNG_LINE#* }" ;; esac
# `missing=<tokens>` is a trailing field on ANY rung — configured reviewer slots whose CLI is
# absent. Split it off the detail so each is reported for what it is: the rung says what WILL
# review the diff, `missing` says which configured slots silently will not.
RUNG_MISSING=""
case "$RUNG_DETAIL" in
  missing=*)   RUNG_MISSING="${RUNG_DETAIL#missing=}"; RUNG_DETAIL="" ;;
  *' missing='*) RUNG_MISSING="${RUNG_DETAIL##* missing=}"; RUNG_DETAIL="${RUNG_DETAIL% missing=*}" ;;
esac
printf 'Review rung: '
case "$RUNG" in
  independent)
    echo "independent in-session review — \`$RUNG_DETAIL\` reviews, and it did not write the code." ;;
  same-model)
    echo "SAME-MODEL only — \`review\` names \`$RUNG_DETAIL\`, which also writes the code."
    echo "             That is the implementer checking itself. Point \`review\` at a different agent,"
    echo "             or declare an async reviewer under [reviewers] bots." ;;
  deferred)
    echo "no in-session reviewer is installed — review is DEFERRED to the PR layer."
    echo "             Declared async reviewer(s): $RUNG_DETAIL."
    # NARROW, on purpose. The declaration withholds /implement-issue's OWN \`--auto\` arm until the
    # reviewer has seen the head commit. It is not branch protection, GitHub does not enforce it,
    # and an owner can still arm or merge by hand — so saying "withholds auto-merge" unqualified
    # would promise a gate that does not exist.
    echo "             That withholds /implement-issue's own auto-merge arm until they see the head"
    echo "             commit — not a manual merge, and not branch protection. Install a reviewer"
    echo "             CLI for an in-session pass." ;;
  none)
    echo "NONE — no reviewer CLI is installed and no async reviewer is declared."
    echo "             Nothing independent will review your diffs. Install a reviewer agent's CLI,"
    echo "             or declare one under [reviewers] bots in agents.toml." ;;
  *)
    # UNKNOWN, or the predicate itself failed. Never resolved toward a rung: every reader here can
    # fail, and each failure would otherwise land on the flattering answer (an invalid \`review\`
    # list reading as "deferred", a malformed bot declaration reading as "none").
    echo "unknown — a role or reviewer declaration could not be read (${RUNG_DETAIL:-no detail})."
    echo "             Fix the manifest error above and re-run; until then, assume nothing"
    echo "             independent reviews your diffs." ;;
esac
# Reported on EVERY rung, including `independent`: a partially-installed `review` list still gets an
# independent pass, and saying only that would present unqualified coverage while a slot the
# operator configured never ran.
[ -z "$RUNG_MISSING" ] || \
  echo "             Configured but NOT installed: $RUNG_MISSING — that slot reviews nothing."
echo ""
# Printing a resolved token without this caveat reads as "the baseline will do this for you."
# Phrased as the durable rule (a role acts only where a workflow resolves it) rather than a list
# of which roles are consumed today — that list would silently go stale the moment one is wired up.
echo "Note: a role names WHO would do the job; it only takes effect where a workflow"
echo "      actually resolves it. \`release\` in particular installs nothing — the baseline"
echo "      ships no /release skill, so a project-owned one must resolve the role itself."
echo ""
echo "Done. See docs/roles-and-agents.md for how roles resolve and delegate."
